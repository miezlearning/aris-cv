{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "out",
    "rootDir": "../src",
    "baseUrl": "..",
    "paths": { "@/*": ["./src/*"] },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": false
  },
  "include": ["../src/lib/*.ts", "../src/types/*.ts"]
}
